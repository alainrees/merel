        }
      }
    },
    "Je logt in bij Microsoft in Safari. Merel ziet je wachtwoord niet en bewaart alleen een sleutel om in te loggen, in de sleutelhanger van deze iPhone.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You sign in with Microsoft in Safari. Merel does not see your password and keeps only a key to sign in with, in this iPhone's keychain."
          }
        }
      }
    },
    "Je wachtwoord blijft in de sleutelhanger van deze iPhone. Merel maakt alleen versleutelde verbindingen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your password stays in this iPhone's keychain. Merel only makes encrypted connections."
          }
        }
      }
    },
    "Je ziet nu voorbeeldmail. Voeg je eigen account toe om je mail te lezen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are looking at sample mail. Add your own account to read your mail."
